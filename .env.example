# Frontend: leave empty locally to use the API mounted in Vite.
# Netlify: set this to the real deployed backend HTTPS origin before building.
VITE_API_URL=
# Backend production service: NODE_ENV=production (binds to 0.0.0.0).
# NODE_ENV=production
# Copy to .env and fill these values to enable email notifications.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL_TO=
# Optional persistent database path (default: data/enquiries.sqlite)
# DATABASE_PATH=data/enquiries.sqlite
# Standalone API listener (npm run server only)
# PORT=3001
# HOST=127.0.0.1
